<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<PackageId>ApiBase.Controller</PackageId>
		<IncludeSymbols>true</IncludeSymbols>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageTags>aspnetcore;webapi;boilerplate;efcore;repository;repository-pattern;unitofwork;dbcontext;crud;generic-repository;api-core;soft-delete;expression-trees;dynamic-filter;pagination</PackageTags>
		<Description>
			ASP.NET Core controller layer for ApiBase. Provides GuidController with
			async GET list and GET by Id out of the box, standardized success/error
			response helpers, dynamic query params binding and structured logging
			via ILogger.
		</Description>
	</PropertyGroup>

	<ItemGroup>
  	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ApiBase.Application\ApiBase.Application.csproj" />
		<ProjectReference Include="..\ApiBase.Domain\ApiBase.Domain.csproj" />
		<ProjectReference Include="..\ApiBase.Infra\ApiBase.Infra.csproj" />
	</ItemGroup>

</Project>
