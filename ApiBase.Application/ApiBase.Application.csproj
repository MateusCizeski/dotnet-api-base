<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>ApiBase.Application</PackageId>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Description>
			Application (read side) layer for ApiBase. ApplicationGuid returns paginated,
			filtered and sorted views, single records by Id and field projections, fully
			async. Override DefaultFilter for tenant isolation or ownership rules.
		</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ApiBase.Domain\ApiBase.Domain.csproj" />
		<ProjectReference Include="..\ApiBase.Infra\ApiBase.Infra.csproj" />
	</ItemGroup>

</Project>
