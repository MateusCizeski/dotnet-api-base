<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>ApiBase.Domain</PackageId>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Description>
			Core contracts and domain primitives for ApiBase. Defines EntityGuid,
			ISoftDelete, IRepositoryBase, IUnitOfWork, the query models (FilterModel,
			SortModel, FilterGroup) and the query exceptions, with zero external dependencies.
		</Description>
	</PropertyGroup>

</Project>
