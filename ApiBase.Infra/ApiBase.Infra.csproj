<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>ApiBase.Infra</PackageId>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Description>
			Query engine for ApiBase. Builds dynamic filters and sorting with expression
			trees, projects to views or runtime types (Reflection.Emit), paginates with a
			configurable page size limit and provides an EF Core Unit of Work.
		</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ApiBase.Domain\ApiBase.Domain.csproj" />
	</ItemGroup>

</Project>
